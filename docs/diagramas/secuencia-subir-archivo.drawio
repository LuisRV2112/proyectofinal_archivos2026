tml=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="1189" as="sourcePoint"/><mxPoint x="960" y="1189" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=26;fontStyle=1;fillColor=none;align=left;spacingLeft=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="1225" width="640" height="56" as="geometry"/></mxCell><mxCell id="c33" value="[falla el insert] → bucket.delete(gridfsId) y $inc: −bytes: ni contenido huérfano ni espacio perdido" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="920" y="1225" width="520" height="24" as="geometry"/></mxCell><mxCell id="c34" value="actividad.insertOne({accion: SUBIR, recursoNombre, detalle})" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="1305" as="sourcePoint"/><mxPoint x="1170" y="1305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="metadatos del archivo" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="1351" as="sourcePoint"/><mxPoint x="540" y="1351" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="201 Created + JSON" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="1397" as="sourcePoint"/><mxPoint x="330" y="1397" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="Barra de progreso → aviso «acta.md subido»&lt;br&gt;y refresca el espacio usado" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint